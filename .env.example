NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# MCP client authentication. Use api-key only for local or controlled private integrations.
MCP_AUTH_MODE=api-key
MCP_API_KEY=
# For standards-based remote OAuth deployments, set MCP_AUTH_MODE=oauth, omit MCP_API_KEY,
# and configure the external authorization server and canonical public origin below.
# MCP_PUBLIC_BASE_URL=https://mcp.example.com
# MCP_OAUTH_ISSUER_URL=https://identity.example.com
# MCP_OAUTH_JWKS_URL=https://identity.example.com/.well-known/jwks.json
# MCP_OAUTH_AUDIENCE=https://mcp.example.com/mcp
# MCP_OAUTH_REQUIRED_SCOPES=fabric.mcp.access

MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
MCP_ALLOWED_ORIGINS=localhost,127.0.0.1,[::1]
LOG_LEVEL=info

# Authentication: auto uses a client secret when AZURE_CLIENT_SECRET is set;
# otherwise it uses DefaultAzureCredential for managed identity or developer credentials.
AZURE_AUTH_MODE=auto
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# Workspace access is determined by the Entra identity's Fabric roles and item permissions.
POWERBI_MCP_READONLY=true

HTTP_TIMEOUT_MS=30000
HTTP_MAX_RETRIES=2
HTTP_MAX_PAGES=100
HTTP_MAX_RESPONSE_BYTES=10485760
LRO_POLL_BUDGET_MS=60000
DAX_MAX_ROWS=1000
DAX_MAX_RESPONSE_BYTES=1048576
DATA_MAX_ROWS=100
DATA_MAX_RESPONSE_BYTES=1048576

# Test-only target for opt-in disposable mutation scripts. Not used by the MCP server.
# FABRIC_TEST_WORKSPACE_ID=
