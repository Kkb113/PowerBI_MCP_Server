NODE_ENV=development
HOST=0.0.0.0
PORT=3000
MCP_API_KEY=replace-with-at-least-32-random-characters
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
MCP_ALLOWED_ORIGINS=localhost,127.0.0.1,[::1]
LOG_LEVEL=info

# Authentication: auto uses a client secret when AZURE_CLIENT_SECRET is set;
# otherwise it uses DefaultAzureCredential for managed identity or developer credentials.
AZURE_AUTH_MODE=auto
# AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
# AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
# AZURE_CLIENT_SECRET=replace-with-a-secret-store-value

# No workspace is accessible when this comma-separated allowlist is empty.
FABRIC_ALLOWED_WORKSPACE_IDS=
POWERBI_MCP_READONLY=true

HTTP_TIMEOUT_MS=30000
HTTP_MAX_RETRIES=2
HTTP_MAX_PAGES=100
HTTP_MAX_RESPONSE_BYTES=10485760
