{
  "name": "fabric-semantic-model-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "Remote MCP server for Microsoft Fabric semantic model lifecycle management",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build",
    "dev": "tsx watch src/index.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:container": "tsx scripts/container-smoke.ts",
    "test:e2e": "vitest run tests/e2e",
    "test:live": "tsx scripts/live-smoke.ts",
    "test:live:data": "tsx scripts/live-data-smoke.ts",
    "test:live:lifecycle": "tsx scripts/live-model-lifecycle.ts",
    "test:live:dax-refresh": "tsx scripts/live-dax-refresh.ts",
    "test:live:full": "tsx scripts/live-full-verification.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@azure/core-auth": "1.11.0",
    "@azure/identity": "4.13.2",
    "@modelcontextprotocol/express": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "express": "5.2.1",
    "tedious": "20.0.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11"
  }
}
