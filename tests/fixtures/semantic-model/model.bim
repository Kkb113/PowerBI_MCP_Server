          }
        ],
        "partitions": [
          {
            "name": "Time Intelligence",
            "mode": "import",
            "source": {
              "type": "calculationGroup"
            },
            "annotations": []
          }
        ],
        "measures": [],
        "hierarchies": [],
        "calculationGroup": {
          "precedence": 10,
          "calculationItems": [
            {
              "name": "Current",
              "expression": "SELECTEDMEASURE()",
              "description": "No time transformation.",
              "ordinal": 0
            },
            {
              "name": "Year to Date",
              "expression": [
                "CALCULATE(",
                "    SELECTEDMEASURE(),",
                "    DATESYTD('Calendar'[Date])",
                ")"
              ],
              "description": "Year-to-date transformation.",
              "formatStringDefinition": {
                "expression": "SELECTEDMEASUREFORMATSTRING()"
              },
              "ordinal": 1
            }
          ]
        },
        "annotations": []
