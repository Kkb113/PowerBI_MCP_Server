                "isKey": false,
                "summarizeBy": "sum",
                "lineageTag": "58ab9571-fbd4-47cc-adac-0dc7d97dcf42",
                "annotations": []
          }
        ],
        "partitions": [
          {
            "name": "Sales Query",
            "mode": "import",
            "source": {
              "type": "query",
              "query": "SELECT OrderId, OrderDate, CustomerId, ProductId, Amount FROM dbo.FactSales",
              "dataSource": "Warehouse Source"
            },
            "annotations": []
          }
        ],
        "measures": [
          {
            "name": "Revenue Δ",
            "expression": [
              "SUM(",
              "    'Sales Data'[Amount]",
              ")"
            ],
            "description": "Total revenue with a Unicode measure name.",
            "displayFolder": "Core Metrics",
            "formatString": "$#,0.00;($#,0.00);$0.00",
            "isHidden": false,
            "lineageTag": "1f8f1a2a-06b6-4989-8af7-212719cf3617",
            "annotations": []
          },
          {
            "name": "Average Ticket",
            "expression": "DIVIDE([Revenue Δ], DISTINCTCOUNT('Sales Data'[Order ID]))",
            "description": "Average revenue per order.",
            "displayFolder": "Core Metrics",
            "formatString": "$#,0.00",
            "isHidden": false,
            "annotations": []
          }
        ],
